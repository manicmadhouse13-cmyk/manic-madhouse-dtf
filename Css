/* ==========================================
   MANIC MADHOUSE DTF DESIGNS
   VERSION 2.0
========================================== */

:root{

--bg:#09090b;
--bg2:#111118;
--card:#1a1a24;

--pink:#ff007a;
--purple:#7b2cff;
--blue:#00d4ff;

--white:#ffffff;
--grey:#c5c5c5;

--shadow:0 20px 40px rgba(0,0,0,.45);

--radius:20px;

}

*{

margin:0;
padding:0;
box-sizing:border-box;

}

html{

scroll-behavior:smooth;

}

body{

font-family:'Poppins',sans-serif;

background:linear-gradient(180deg,#09090b,#12121b);

color:white;

overflow-x:hidden;

}

/* Scrollbar */

::-webkit-scrollbar{

width:10px;

}

::-webkit-scrollbar-track{

background:#111;

}

::-webkit-scrollbar-thumb{

background:linear-gradient(var(--pink),var(--purple));

border-radius:20px;

}

/* Links */

a{

text-decoration:none;

color:white;

transition:.3s;

}

img{

width:100%;
display:block;

}

/* Container */

.container{

width:90%;
max-width:1320px;

margin:auto;

}

/* ===========================
NAVBAR
=========================== */

.navbar{

background:rgba(10,10,15,.65);

backdrop-filter:blur(18px);

padding:18px 0;

transition:.4s;

border-bottom:1px solid rgba(255,255,255,.08);

}

.navbar-brand img{

height:70px;

}

.nav-link{

color:white!important;

font-weight:600;

margin-left:20px;

position:relative;

}

.nav-link::after{

content:"";

position:absolute;

left:0;

bottom:-8px;

width:0;

height:3px;

background:linear-gradient(90deg,var(--pink),var(--purple));

transition:.35s;

}

.nav-link:hover::after{

width:100%;

}

.cart-button{

margin-left:25px;

}

.cart-button a{

background:linear-gradient(90deg,var(--pink),var(--purple));

padding:12px 20px;

border-radius:40px;

font-weight:700;

box-shadow:0 0 20px rgba(255,0,122,.45);

}

/* ===========================
LOADER
=========================== */

#loader{

position:fixed;

inset:0;

background:#09090b;

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

z-index:99999;

}

#loader img{

width:140px;

margin-bottom:20px;

animation:pulse 2s infinite;

}

@keyframes pulse{

50%{

transform:scale(1.08);

}

}

/* ===========================
HERO
=========================== */

.hero{

position:relative;

padding-top:180px;

padding-bottom:140px;

overflow:hidden;

}

.hero::before{

content:"";

position:absolute;

width:900px;

height:900px;

background:radial-gradient(circle,var(--purple),transparent 70%);

opacity:.18;

top:-250px;

right:-200px;

filter:blur(70px);

}

.hero::after{

content:"";

position:absolute;

width:800px;

height:800px;

background:radial-gradient(circle,var(--pink),transparent 70%);

left:-250px;

bottom:-250px;

opacity:.18;

filter:blur(70px);

}

.hero-content{

position:relative;

z-index:2;

}

.hero-tag{

display:inline-block;

padding:10px 18px;

border-radius:50px;

background:rgba(255,255,255,.08);

margin-bottom:25px;

font-size:.9rem;

letter-spacing:1px;

}

.hero h1{

font-size:4.6rem;

font-weight:800;

line-height:1.05;

margin-bottom:20px;

}

.hero h1 span{

background:linear-gradient(90deg,var(--pink),var(--blue));

-webkit-background-clip:text;

-webkit-text-fill-color:transparent;

}

.hero p{

font-size:1.2rem;

color:var(--grey);

line-height:2;

max-width:600px;

margin-bottom:40px;

}

/* Buttons */

.btn{

padding:16px 38px;

border-radius:50px;

font-weight:700;

transition:.35s;

border:none;

}

.btn-primary{

background:linear-gradient(90deg,var(--pink),var(--purple));

}

.btn-primary:hover{

transform:translateY(-5px);

box-shadow:0 0 35px rgba(255,0,122,.55);

}

.btn-outline-light{

border:2px solid white;

}

.btn-outline-light:hover{

background:white;

color:#111;

}

/* Hero Images */

.hero-collage{

position:relative;

height:650px;

}

.hero-collage img{

position:absolute;

border-radius:18px;

box-shadow:var(--shadow);

transition:.4s;

}

.hero-collage img:hover{

transform:scale(1.06) rotate(2deg);

}

.img1{

width:240px;

top:10px;

left:40px;

}

.img2{

width:240px;

top:120px;

right:0;

}

.img3{

width:240px;

bottom:30px;

left:0;

}

.img4{

width:230px;

bottom:0;

right:50px;

}

.img5{

width:260px;

top:240px;

left:180px;

z-index:5;

}
