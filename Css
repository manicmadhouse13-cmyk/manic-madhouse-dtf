/* ==========================================
   MANIC MADHOUSE DTF DESIGNS
   VERSION 2.0
========================================== */

:root{

--bg:#09090b;
--bg2:#111118;
--card:#1a1a24;

--pink:#ff007a;
--purple:#7b2cff;
--blue:#00d4ff;

--white:#ffffff;
--grey:#c5c5c5;

--shadow:0 20px 40px rgba(0,0,0,.45);

--radius:20px;

}

*{

margin:0;
padding:0;
box-sizing:border-box;

}

html{

scroll-behavior:smooth;

}

body{

font-family:'Poppins',sans-serif;

background:linear-gradient(180deg,#09090b,#12121b);

color:white;

overflow-x:hidden;

}

/* Scrollbar */

::-webkit-scrollbar{

width:10px;

}

::-webkit-scrollbar-track{

background:#111;

}

::-webkit-scrollbar-thumb{

background:linear-gradient(var(--pink),var(--purple));

border-radius:20px;

}

/* Links */

a{

text-decoration:none;

color:white;

transition:.3s;

}

img{

width:100%;
display:block;

}

/* Container */

.container{

width:90%;
max-width:1320px;

margin:auto;

}

/* ===========================
NAVBAR
=========================== */

.navbar{

background:rgba(10,10,15,.65);

backdrop-filter:blur(18px);

padding:18px 0;

transition:.4s;

border-bottom:1px solid rgba(255,255,255,.08);

}

.navbar-brand img{

height:70px;

}

.nav-link{

color:white!important;

font-weight:600;

margin-left:20px;

position:relative;

}

.nav-link::after{

content:"";

position:absolute;

left:0;

bottom:-8px;

width:0;

height:3px;

background:linear-gradient(90deg,var(--pink),var(--purple));

transition:.35s;

}

.nav-link:hover::after{

width:100%;

}

.cart-button{

margin-left:25px;

}

.cart-button a{

background:linear-gradient(90deg,var(--pink),var(--purple));

padding:12px 20px;

border-radius:40px;

font-weight:700;

box-shadow:0 0 20px rgba(255,0,122,.45);

}

/* ===========================
LOADER
=========================== */

#loader{

position:fixed;

inset:0;

background:#09090b;

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

z-index:99999;

}

#loader img{

width:140px;

margin-bottom:20px;

animation:pulse 2s infinite;

}

@keyframes pulse{

50%{

transform:scale(1.08);

}

}

/* ===========================
HERO
=========================== */

.hero{

position:relative;

padding-top:180px;

padding-bottom:140px;

overflow:hidden;

}

.hero::before{

content:"";

position:absolute;

width:900px;

height:900px;

background:radial-gradient(circle,var(--purple),transparent 70%);

opacity:.18;

top:-250px;

right:-200px;

filter:blur(70px);

}

.hero::after{

content:"";

position:absolute;

width:800px;

height:800px;

background:radial-gradient(circle,var(--pink),transparent 70%);

left:-250px;

bottom:-250px;

opacity:.18;

filter:blur(70px);

}

.hero-content{

position:relative;

z-index:2;

}

.hero-tag{

display:inline-block;

padding:10px 18px;

border-radius:50px;

background:rgba(255,255,255,.08);

margin-bottom:25px;

font-size:.9rem;

letter-spacing:1px;

}

.hero h1{

font-size:4.6rem;

font-weight:800;

line-height:1.05;

margin-bottom:20px;

}

.hero h1 span{

background:linear-gradient(90deg,var(--pink),var(--blue));

-webkit-background-clip:text;

-webkit-text-fill-color:transparent;

}

.hero p{

font-size:1.2rem;

color:var(--grey);

line-height:2;

max-width:600px;

margin-bottom:40px;

}

/* Buttons */

.btn{

padding:16px 38px;

border-radius:50px;

font-weight:700;

transition:.35s;

border:none;

}

.btn-primary{

background:linear-gradient(90deg,var(--pink),var(--purple));

}

.btn-primary:hover{

transform:translateY(-5px);

box-shadow:0 0 35px rgba(255,0,122,.55);

}

.btn-outline-light{

border:2px solid white;

}

.btn-outline-light:hover{

background:white;

color:#111;

}

/* Hero Images */

.hero-collage{

position:relative;

height:650px;

}

.hero-collage img{

position:absolute;

border-radius:18px;

box-shadow:var(--shadow);

transition:.4s;

}

.hero-collage img:hover{

transform:scale(1.06) rotate(2deg);

}

.img1{

width:240px;

top:10px;

left:40px;

}

.img2{

width:240px;

top:120px;

right:0;

}

.img3{

width:240px;

bottom:30px;

left:0;

}

.img4{

width:230px;

bottom:0;

right:50px;

}

.img5{

width:260px;

top:240px;

left:180px;

z-index:5;

}
/* ===========================
SECTION TITLES
=========================== */

section{
    padding:100px 0;
    position:relative;
}

.section-title{
    text-align:center;
    margin-bottom:60px;
}

.section-title h2{
    font-size:3rem;
    font-weight:800;
    margin-bottom:15px;
    color:#fff;
}

.section-title p{
    color:#bfbfbf;
    max-width:700px;
    margin:auto;
    font-size:1.1rem;
}

/* ===========================
FEATURED COLLECTIONS
=========================== */

.collections{
    background:#101018;
}

.collection-card{
    background:#191925;
    border-radius:20px;
    overflow:hidden;
    transition:.35s;
    box-shadow:0 10px 30px rgba(0,0,0,.35);
    height:100%;
}

.collection-card img{
    height:260px;
    width:100%;
    object-fit:cover;
}

.collection-card:hover{
    transform:translateY(-10px);
    box-shadow:0 0 40px rgba(255,0,122,.35);
}

.collection-info{
    padding:25px;
}

.collection-info h3{
    margin-bottom:10px;
    font-weight:700;
}

.collection-info p{
    color:#c8c8c8;
    margin-bottom:20px;
}

.collection-info a{
    color:#ff007a;
    font-weight:700;
}

.featured{
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:40px;
    background:linear-gradient(145deg,#ff007a,#7b2cff);
}

.featured h3{
    font-size:2rem;
    margin-bottom:20px;
}

.featured p{
    color:white;
}

/* ===========================
PRODUCTS
=========================== */

.product-card{
    background:#171721;
    border-radius:20px;
    overflow:hidden;
    transition:.35s;
    position:relative;
    height:100%;
}

.product-card:hover{
    transform:translateY(-10px);
    box-shadow:0 0 35px rgba(123,44,255,.45);
}

.product-image{
    position:relative;
    overflow:hidden;
}

.product-image img{
    height:330px;
    object-fit:cover;
    transition:.5s;
}

.product-card:hover img{
    transform:scale(1.08);
}

.badge-new{
    position:absolute;
    top:15px;
    left:15px;
    background:#ff007a;
    color:white;
    padding:8px 14px;
    border-radius:50px;
    font-size:.8rem;
    font-weight:700;
}

.product-info{
    padding:25px;
}

.product-info h4{
    font-weight:700;
}

.product-info p{
    color:#bdbdbd;
    margin:15px 0;
}

.product-info .btn{
    width:100%;
}
/* ===========================
WHY CHOOSE US
=========================== */

.why-us{
    background:#0d0d13;
}

.feature-box{
    background:#171721;
    border-radius:20px;
    padding:40px 30px;
    transition:.3s;
    height:100%;
}

.feature-box:hover{
    transform:translateY(-8px);
    box-shadow:0 0 35px rgba(255,0,122,.35);
}

.feature-box h1{
    font-size:3.5rem;
    margin-bottom:20px;
}

.feature-box h4{
    margin-bottom:15px;
}

.feature-box p{
    color:#cfcfcf;
}

/* ===========================
WEDDINGS
=========================== */

.wedding-section{
    background:#12121a;
}

.section-tag{
    display:inline-block;
    padding:8px 16px;
    background:#ff007a;
    border-radius:40px;
    margin-bottom:20px;
    font-weight:600;
}

.service-list{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:15px;
    margin-top:30px;
}

.service-list div{
    background:#1b1b25;
    padding:15px;
    border-radius:12px;
}

/* ===========================
BUSINESS
=========================== */

.business-card{
    background:#171721;
    border-radius:20px;
    padding:40px;
    text-align:center;
    transition:.3s;
    height:100%;
    font-size:1.1rem;
}

.business-card:hover{
    transform:translateY(-10px);
    box-shadow:0 0 35px rgba(0,212,255,.35);
}
/* ===========================
UPLOAD SECTION
=========================== */

.upload-section{
    background:linear-gradient(135deg,#12121b,#1d1d2a);
    text-align:center;
}

.upload-box{
    max-width:800px;
    margin:50px auto;
    padding:60px;
    border:2px dashed rgba(255,255,255,.2);
    border-radius:25px;
    background:rgba(255,255,255,.03);
    transition:.3s;
}

.upload-box:hover{
    border-color:var(--pink);
    box-shadow:0 0 40px rgba(255,0,122,.25);
}

.upload-box i{
    font-size:4rem;
    color:var(--pink);
    display:block;
    margin-bottom:20px;
}

.upload-box h3{
    font-size:2rem;
    margin-bottom:15px;
}

.upload-box p{
    color:var(--grey);
    margin-bottom:30px;
}

/* ===========================
REVIEWS
=========================== */

.reviews{
    background:#101018;
}

.review-card{
    background:#181824;
    padding:35px;
    border-radius:20px;
    height:100%;
    transition:.3s;
}

.review-card:hover{
    transform:translateY(-10px);
    box-shadow:0 0 35px rgba(123,44,255,.35);
}

.review-card p{
    margin:20px 0;
    color:#d0d0d0;
    line-height:1.8;
}

.review-card strong{
    color:var(--pink);
}

/* ===========================
INSTAGRAM
=========================== */

.instagram{
    background:#09090b;
}

.instagram-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
}

.instagram-grid img{
    border-radius:18px;
    transition:.35s;
    cursor:pointer;
}

.instagram-grid img:hover{
    transform:scale(1.05);
    box-shadow:0 0 30px rgba(255,0,122,.35);
}

/* ===========================
NEWSLETTER
=========================== */

.newsletter{
    background:linear-gradient(90deg,var(--pink),var(--purple));
    text-align:center;
}

.newsletter h2{
    color:white;
    font-size:3rem;
}

.newsletter p{
    color:white;
    margin:20px auto;
    max-width:600px;
}

.newsletter-form{
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
    margin-top:30px;
}

.newsletter-form input{
    width:350px;
    max-width:100%;
    padding:18px;
    border:none;
    border-radius:50px;
    font-size:1rem;
}

.newsletter-form button{
    border:none;
    padding:18px 35px;
    border-radius:50px;
    background:#111;
    color:white;
    font-weight:700;
    transition:.3s;
}

.newsletter-form button:hover{
    background:white;
    color:#111;
}

/* ===========================
FOOTER
=========================== */

footer{
    background:#060606;
    padding:70px 0 30px;
}

footer h3,
footer h4{
    margin-bottom:20px;
}

footer p,
footer li{
    color:#bdbdbd;
    line-height:2;
}

footer ul{
    list-style:none;
    padding:0;
}

footer a{
    color:#bdbdbd;
}

footer a:hover{
    color:var(--pink);
}

footer hr{
    border-color:rgba(255,255,255,.1);
    margin:40px 0;
}

footer .text-center{
    color:#888;
}
/* ======================
ANIMATIONS
====================== */

.hidden{

opacity:0;

transform:translateY(60px);

transition:all .8s ease;

}

.show{

opacity:1;

transform:translateY(0);

}

.cursorGlow{

position:fixed;

width:300px;

height:300px;

background:radial-gradient(circle,
rgba(255,0,122,.12),
transparent 70%);

pointer-events:none;

transform:translate(-50%,-50%);
.small-hero{

padding-top:170px;

padding-bottom:70px;

text-align:center;

}

.form-control,
.form-select{

background:#181824;

border:none;

color:white;

padding:16px;

}

.form-control:focus,
.form-select:focus{

background:#181824;

color:white;

box-shadow:0 0 20px rgba(255,0,122,.35);

}

.form-select option{

background:#181824;
/* ===========================
MOCKUP DESIGNER
=========================== */

#mockupArea{

position:relative;

max-width:650px;

margin:auto;

}

#shirt{

width:100%;

display:block;

}

#design{

position:absolute;

left:50%;

top:50%;

width:180px;

transform:translate(-50%,-50%);

cursor:move;

display:none;

transition:.15s;

}

.form-range{

accent-color:#ff007a;

}
color:white;

}
z-index:0;

filter:blur(25px);

}
/* ===========================
PRODUCT PAGE
=========================== */

#productImage{

border-radius:20px;

box-shadow:0 20px 40px rgba(0,0,0,.4);

}

#productName{

font-size:3rem;

font-weight:800;

margin-bottom:15px;

}

#productPrice{

color:var(--pink);

font-size:2rem;

margin-bottom:25px;

}

.form-control,
.form-select{

background:#181824;

border:1px solid rgba(255,255,255,.08);

color:white;

}

.form-control:focus,
.form-select:focus{

background:#181824;

color:white;

border-color:var(--pink);

box-shadow:0 0 20px rgba(255,0,122,.35);

}
/* ======================
SHOPPING CART
====================== */

.cart-card{

background:#171721;

padding:25px;

margin-bottom:20px;

border-radius:20px;

transition:.3s;

}

.cart-card:hover{

box-shadow:0 0 35px rgba(255,0,122,.25);

transform:translateY(-4px);

}

.cart-card img{

border-radius:15px;

}
/* ======================
CHECKOUT
====================== */

.checkout-box{

background:#171721;

padding:40px;

border-radius:20px;

}

.checkout-summary{

background:#12121a;

padding:35px;

border-radius:20px;

position:sticky;

top:120px;

}

.checkout-summary h2{

color:var(--pink);

margin-top:25px;

}
